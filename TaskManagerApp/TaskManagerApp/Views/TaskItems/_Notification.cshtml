@if (TempData["NotificationMessage"] is string notification)
{
    var parts = notification.Split(new[] { ':' }, 2);
    var type = parts.Length > 1 ? parts[0] : "success";
    var message = parts.Length > 1 ? parts[1] : notification;
    <div class="notification @type" data-notification role="status"><span>✓</span><b>@message</b><button type="button" aria-label="@T["Close"]">×</button></div>
}
