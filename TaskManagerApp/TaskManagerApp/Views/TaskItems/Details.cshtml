@model TaskItem
@{ ViewData["Title"] = T["DetailsTitle"]; }
<section class="editor-layout"><header><a asp-action="Index">← @T["Back"]</a><span class="eyebrow">MISSION VP-@Model.Id.ToString("D4")</span><h1>@T["DetailsTitle"]</h1></header>
<article class="detail-card priority-@Model.Priority.ToString().ToLowerInvariant()">
    <div class="detail-status"><span class="priority-chip">@T[Model.Priority.ToString()]</span><strong class="@(Model.IsCompleted ? "done" : "open")">@(Model.IsCompleted ? T["Completed"] : T["Open"])</strong></div>
    <h2>@Model.Title</h2><p class="detail-description">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</p>
    <dl><div><dt>@T["Created"]</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy · HH:mm")</dd></div><div><dt>@T["Due"]</dt><dd>@(Model.DueDate?.ToString("dd MMMM yyyy") ?? T["NoDueDate"])</dd></div><div><dt>@T["Priority"]</dt><dd>@T[Model.Priority.ToString()]</dd></div></dl>
    <div class="form-actions"><a class="button primary" asp-action="Edit" asp-route-id="@Model.Id">@T["Edit"]</a><a class="button secondary" asp-action="Delete" asp-route-id="@Model.Id">@T["Delete"]</a></div>
</article></section>
