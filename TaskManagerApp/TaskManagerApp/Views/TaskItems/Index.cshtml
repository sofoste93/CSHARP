@model TaskDashboardViewModel
@{ ViewData["Title"] = T["Dashboard"]; var returnUrl = Context.Request.Path + Context.Request.QueryString; }
<partial name="_Notification" />

<section class="dashboard-head">
    <div><span class="eyebrow">@T["DashboardEyebrow"]</span><h1>@T["Dashboard"]</h1><p>@T["DashboardIntro"]</p></div>
    <a class="button primary" asp-action="Create"><span>＋</span> @T["NewTask"]</a>
</section>

<section class="metric-grid">
    <a asp-action="Index" class="metric @(Model.Filter == "all" ? "active" : "")"><span>@T["Total"]</span><strong>@Model.Total</strong><i style="--meter:100%"></i></a>
    <a asp-action="Index" asp-route-filter="open" class="metric @(Model.Filter == "open" ? "active" : "")"><span>@T["Open"]</span><strong>@Model.Open</strong><i style="--meter:@(Model.Total == 0 ? 0 : Model.Open * 100 / Model.Total)%"></i></a>
    <a asp-action="Index" asp-route-filter="completed" class="metric @(Model.Filter == "completed" ? "active" : "")"><span>@T["Completed"]</span><strong>@Model.Completed</strong><i style="--meter:@(Model.Total == 0 ? 0 : Model.Completed * 100 / Model.Total)%"></i></a>
    <a asp-action="Index" asp-route-filter="overdue" class="metric danger @(Model.Filter == "overdue" ? "active" : "")"><span>@T["Overdue"]</span><strong>@Model.Overdue</strong><i style="--meter:@(Model.Total == 0 ? 0 : Model.Overdue * 100 / Model.Total)%"></i></a>
</section>

<form method="get" class="filter-bar">
    <div class="search-field"><svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" name="search" value="@Model.Search" placeholder="@T["SearchPlaceholder"]" aria-label="@T["Search"]" /></div>
    <select name="filter" aria-label="Filter"><option value="all" selected="@(Model.Filter == "all")">@T["All"]</option><option value="open" selected="@(Model.Filter == "open")">@T["Open"]</option><option value="completed" selected="@(Model.Filter == "completed")">@T["Completed"]</option><option value="overdue" selected="@(Model.Filter == "overdue")">@T["Overdue"]</option></select>
    <select name="sort" aria-label="Sort"><option value="newest" selected="@(Model.Sort == "newest")">@T["Newest"]</option><option value="due" selected="@(Model.Sort == "due")">@T["DueSoon"]</option><option value="priority" selected="@(Model.Sort == "priority")">@T["PrioritySort"]</option></select>
    <button class="button secondary" type="submit">@T["Apply"]</button>
</form>

@if (!Model.Tasks.Any())
{
    <section class="empty-state"><div class="empty-pulsar"><i></i></div><h2>@T["NoTasks"]</h2><p>@T["NoTasksText"]</p><a class="button primary" asp-action="Create">@T["NewTask"]</a></section>
}
else
{
    <section class="task-grid">
    @foreach (var item in Model.Tasks)
    {
        var overdue = !item.IsCompleted && item.DueDate.HasValue && item.DueDate.Value.Date < DateTime.UtcNow.Date;
        <article class="task-card priority-@item.Priority.ToString().ToLowerInvariant() @(item.IsCompleted ? "complete" : "")">
            <div class="task-top"><span class="priority-chip">@T[item.Priority.ToString()]</span><span class="task-id">VP-@item.Id.ToString("D4")</span></div>
            <h2>@item.Title</h2><p>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</p>
            <div class="task-meta"><span>@T["Created"] <b>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</b></span><span class="@(overdue ? "overdue" : "")">@T["Due"] <b>@(item.DueDate?.ToString("dd MMM yyyy") ?? T["NoDueDate"])</b></span></div>
            <div class="task-actions">
                <form asp-action="Toggle" asp-route-id="@item.Id" method="post"><input type="hidden" name="returnUrl" value="@returnUrl"/><button class="complete-control" type="submit"><i>✓</i> @(item.IsCompleted ? T["Reopen"] : T["MarkDone"])</button></form>
                <div><a asp-action="Details" asp-route-id="@item.Id">@T["Details"]</a><a asp-action="Edit" asp-route-id="@item.Id">@T["Edit"]</a><a class="delete-link" asp-action="Delete" asp-route-id="@item.Id">@T["Delete"]</a></div>
            </div>
        </article>
    }
    </section>
}
