@model TaskItem
@{ ViewData["Title"] = T["DeleteTitle"]; }
<section class="editor-layout danger-zone"><header><a asp-action="Index">← @T["Back"]</a><span class="eyebrow">IRREVERSIBLE ACTION</span><h1>@T["ConfirmDelete"]</h1><p>@T["DeleteWarning"]</p></header>
<article class="delete-card"><span class="priority-chip">@T[Model.Priority.ToString()]</span><h2>@Model.Title</h2><p>@Model.Description</p><form method="post"><input type="hidden" asp-for="Id"/><div class="form-actions"><button class="button danger" type="submit">@T["Delete"]</button><a class="button secondary" asp-action="Index">@T["Cancel"]</a></div></form></article></section>
