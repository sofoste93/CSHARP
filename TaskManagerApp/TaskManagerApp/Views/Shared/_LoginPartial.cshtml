@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div class="account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <a class="account-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="@T["Account"]"><span>@(User.Identity?.Name?.Substring(0, 1).ToUpperInvariant())</span><em>@User.Identity?.Name</em></a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
        <button type="submit" class="text-control">@T["Logout"]</button>
    </form>
}
else
{
    <a class="text-control" asp-area="Identity" asp-page="/Account/Login">@T["Login"]</a>
    <a class="button small" asp-area="Identity" asp-page="/Account/Register">@T["Register"]</a>
}
</div>
