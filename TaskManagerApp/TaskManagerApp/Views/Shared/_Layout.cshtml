<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090716" />
    <meta name="description" content="Violet Pulsar — private cross-platform task orbit." />
    <title>@ViewData["Title"] · @T["AppName"]</title>
    <link rel="icon" href="~/images/pulsar-mark.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="cosmos" aria-hidden="true"><i></i><i></i><i></i><span></span></div>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="7"/><path d="M4 26c11-8 29-10 40-4M9 33c11-5 23-7 34-5"/><path d="M24 4v8M24 36v8"/></svg>
            <span><b>VIOLET PULSAR</b><small>@T["Tagline"]</small></span>
        </a>
        <button class="mobile-menu" type="button" data-menu-toggle aria-label="Menu"><span></span><span></span></button>
        <nav class="main-nav" data-menu>
            <a asp-controller="Home" asp-action="Index">@T["Home"]</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="TaskItems" asp-action="Index">@T["Tasks"]</a>
            }
            <a asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
        </nav>
        <div class="top-actions">
            <span class="signal"><i></i> PULSAR ONLINE</span>
            <button class="icon-control" type="button" data-settings-open aria-label="@T["Settings"]" title="@T["Settings"]">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2Zm8.5 3.6-.1-1.4 2-1.6-2-3.5-2.6 1a9 9 0 0 0-2.2-1.3L15.1 3H9l-.5 2.2a9 9 0 0 0-2.2 1.3l-2.5-1-2 3.5 2 1.6a9 9 0 0 0 0 2.8l-2 1.6 2 3.5 2.5-1a9 9 0 0 0 2.2 1.3L9 21h6l.5-2.2a9 9 0 0 0 2.2-1.3l2.6 1 2-3.5-2-1.6.2-1.4Z"/></svg>
            </button>
            <partial name="_LoginPartial" />
        </div>
    </header>

    <main class="page-shell">@RenderBody()</main>

    <footer class="footer">
        <span>© 2026 @T["AppName"] · @T["Footer"]</span>
        <span class="footer-signal">THOR // SIGNAL STABLE</span>
    </footer>

    <dialog class="settings-dialog" data-settings-dialog>
        <form asp-controller="Preferences" asp-action="Culture" method="post" class="settings-card" data-settings-form>
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
            <div class="modal-head"><div><span class="eyebrow">ORBIT CONFIG</span><h2>@T["Settings"]</h2></div><button type="button" class="icon-control" data-settings-close aria-label="@T["Close"]">×</button></div>
            <label class="setting-row"><span><b>@T["Language"]</b><small>English / Deutsch</small></span>
                <select name="culture" data-culture><option value="en">English</option><option value="de">Deutsch</option></select>
            </label>
            <label class="setting-row"><span><b>@T["Theme"]</b><small>@T["ThemeHelp"]</small></span>
                <select data-theme><option value="dark">@T["Dark"]</option><option value="light">@T["Light"]</option><option value="system">@T["System"]</option></select>
            </label>
            <label class="setting-row"><span><b>@T["Density"]</b><small>@T["DensityHelp"]</small></span><input type="checkbox" role="switch" data-compact /></label>
            <label class="setting-row"><span><b>@T["Motion"]</b><small>@T["MotionHelp"]</small></span><input type="checkbox" role="switch" data-reduced-motion /></label>
            <button class="button primary full" type="submit">@T["SaveSettings"]</button>
        </form>
    </dialog>

    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script>window.pulsarCulture = '@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName';</script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
